---
import '~/styles/global.css';
import LangToggle from '~/components/LangToggle.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import type { Locale, LocalizedValue } from '~/lib/i18n';
import { getDictionary, localizePath, resolveLocale, resolveLocalizedValue } from '~/lib/i18n';
import { THEME_STORAGE_KEY } from '~/lib/theme';

type BaseProps = {
  title?: LocalizedValue<string>;
  description?: LocalizedValue<string>;
};

// Shared page shell: sets up navigation, metadata, and localized scaffolding.
const props = Astro.props as BaseProps;
const locale: Locale = resolveLocale(Astro.currentLocale);
const dictionary = getDictionary(locale);

const resolvedTitle = resolveLocalizedValue(props.title, locale) ?? `${dictionary.site.name}`;
const resolvedDescription =
  resolveLocalizedValue(props.description, locale) ?? dictionary.site.description;

const navLinks = [
  {
    href: localizePath('/projects', locale),
    label: dictionary.nav.projects,
  },
  {
    href: localizePath('/blogs', locale),
    label: dictionary.nav.blogs,
  },
];

const pathname = Astro.url.pathname;
const currentYear = new Date().getFullYear();
---

<html lang={locale} class="h-full" data-theme="light" data-theme-storage={THEME_STORAGE_KEY}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <noscript>
      <style>
        .logo-img {
          opacity: 1 !important;
        }
        .logo-skeleton {
          display: none !important;
        }
      </style>
    </noscript>
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const storageKey = root?.dataset?.themeStorage || 'preferred-theme';
        const prefersDark = () =>
          typeof window !== 'undefined' && typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : false;
        const setTheme = (theme) => {
          if (!root) return;
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
        };
        try {
          const stored = storageKey ? localStorage.getItem(storageKey) : null;
          if (stored === 'light' || stored === 'dark') {
            setTheme(stored);
            return;
          }
        } catch {
          // Ignore storage access issues and fall back to system preference.
        }
        setTheme(prefersDark() ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-white text-slate-900 transition-colors duration-200 dark:bg-slate-950 dark:text-slate-100"
  >
    <header class="border-b border-slate-200 dark:border-slate-800">
      <nav
        class="container flex flex-col gap-3 py-3 text-slate-700 dark:text-slate-300 sm:flex-row sm:items-center sm:gap-6 sm:py-2"
      >
        <div class="flex items-center justify-between gap-4 sm:justify-start">
          <a
            href={localizePath('/', locale)}
            class="flex items-center gap-2 font-semibold text-slate-900 transition-colors hover:text-slate-700 dark:text-white dark:hover:text-slate-200"
          >
            <span class="relative flex h-14 w-14 items-center justify-center sm:h-16 sm:w-16">
              <span
                class="logo-skeleton absolute inset-0 animate-pulse rounded bg-slate-200/80 dark:bg-slate-700/60"
                aria-hidden="true"></span>
              <img
                src="/logo-light.svg"
                alt=""
                loading="eager"
                class="logo-img h-14 w-14 object-contain transition-opacity duration-200 data-[loaded=false]:opacity-0 data-[loaded=true]:opacity-100 sm:h-16 sm:w-16"
                data-loaded="false"
                data-theme-image
                data-theme-src-light="/logo-light.svg"
                data-theme-src-dark="/logo-dark.svg"
                onload="this.dataset.loaded='true'; const skeleton = this.previousElementSibling; if (skeleton?.classList?.contains('logo-skeleton')) { skeleton.remove(); }"
                aria-hidden="true"
              />
            </span>
            <span>{dictionary.site.name}</span>
          </a>
          <button
            type="button"
            class="flex h-10 w-10 items-center justify-center rounded border border-slate-300 text-slate-600 transition hover:border-slate-400 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 dark:border-slate-600 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white dark:focus-visible:ring-slate-500 sm:hidden"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="primary-navigation"
          >
            <span class="sr-only">Menu</span>
            <svg
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M3 6.5h14M3 10h14M3 13.5h14"></path>
            </svg>
          </button>
        </div>
        <div
          id="primary-navigation"
          data-nav-menu
          data-open="false"
          class="hidden flex-col gap-3 text-slate-600 dark:text-slate-300 sm:flex sm:flex-1 sm:flex-row sm:items-center sm:gap-4"
        >
          <div class="flex flex-col gap-3 sm:flex-1 sm:flex-row sm:items-center sm:gap-4">
            {
              navLinks.map((link) => (
                <a href={link.href} class="transition hover:text-slate-900 dark:hover:text-white">
                  {link.label}
                </a>
              ))
            }
          </div>
          <div
            class="mt-2 border-t border-slate-200 pt-2 dark:border-slate-700 sm:ml-3 sm:mt-0 sm:border-0 sm:p-0"
          >
            <div class="flex flex-wrap items-center gap-2 sm:justify-end">
              <ThemeToggle locale={locale} />
              <LangToggle class="sm:ml-1" locale={locale} pathname={pathname} />
            </div>
          </div>
        </div>
      </nav>
      <script>
        if (typeof window !== 'undefined') {
          const navToggle = document.querySelector('[data-nav-toggle]');
          const navMenu = document.querySelector('[data-nav-menu]');
          if (navToggle instanceof HTMLElement && navMenu instanceof HTMLElement) {
            const setState = (open: boolean) => {
              navMenu.dataset.open = open ? 'true' : 'false';
              navMenu.classList.toggle('hidden', !open);
              navToggle.setAttribute('aria-expanded', open.toString());
            };

            const enforceDesktopLayout = () => {
              navMenu.classList.remove('hidden');
              navToggle.setAttribute('aria-expanded', 'true');
            };

            const resetMobileLayout = () => {
              navMenu.dataset.open = 'false';
              navMenu.classList.add('hidden');
              navToggle.setAttribute('aria-expanded', 'false');
            };

            const mql = window.matchMedia('(min-width: 640px)');
            if (mql.matches) {
              enforceDesktopLayout();
            } else {
              resetMobileLayout();
            }

            mql.addEventListener('change', (event: MediaQueryListEvent) => {
              if (event.matches) {
                enforceDesktopLayout();
              } else {
                resetMobileLayout();
              }
            });

            navToggle.addEventListener('click', () => {
              if (mql.matches) {
                return;
              }
              const shouldOpen = navMenu.classList.contains('hidden');
              setState(shouldOpen);
            });
          }
        }
      </script>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div class="container py-6 text-sm text-slate-600 dark:text-slate-400">
        © {currentYear} Tobias Wulff. {dictionary.footer.rights}
      </div>
    </footer>
  </body>
</html>
