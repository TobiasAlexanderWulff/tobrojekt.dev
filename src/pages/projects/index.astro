---
import Base from '~/layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { resolveProjectLink } from '~/lib/links';
import type { ProjectLinkInput, ResolvedProjectLink } from '~/lib/links';
import { getDictionary, resolveLocale, localizePath, resolveLocalizedValue } from '~/lib/i18n';

type ProjectEntry = CollectionEntry<'projects'>;
type LocalizedProject = {
  entry: ProjectEntry;
  title: string;
  summary: string;
  links: ResolvedProjectLink[];
};

const all = await getCollection('projects');
const recent = all.filter((p) => p.data.visibility !== 'private').slice(0, 6);
const projects = all
  .filter((p) => p.data.visibility !== 'private')
  .sort((a, b) => (a.data.priority ?? 999) - (b.data.priority ?? 999));

const locale = resolveLocale(Astro.currentLocale);
const dictionary = getDictionary(locale);
const pageTitle = `${dictionary.projectsIndex.heading} – ${dictionary.site.name}`;
const localizedProjects: LocalizedProject[] = projects.map((entry) => ({
  entry,
  title: resolveLocalizedValue(entry.data.title, locale) ?? '',
  summary: resolveLocalizedValue(entry.data.summary, locale) ?? '',
  links: (entry.data.links ?? []).map((link: ProjectLinkInput) =>
    resolveProjectLink(link, dictionary),
  ),
}));
const recentLocalized: LocalizedProject[] = recent.map((entry) => ({
  entry,
  title: resolveLocalizedValue(entry.data.title, locale) ?? '',
  summary: resolveLocalizedValue(entry.data.summary, locale) ?? '',
  links: (entry.data.links ?? []).map((link: ProjectLinkInput) =>
    resolveProjectLink(link, dictionary),
  ),
}));
---

<Base title={pageTitle} description={dictionary.projectsIndex.metaDescription}>
  <section class="container py-10">
    <h1 class="mb-6 text-3xl font-bold">{dictionary.projectsIndex.heading}</h1>
    <p class="max-w-prose whitespace-pre-line text-slate-700 dark:text-slate-300">
      {dictionary.projectsIndex.description}
    </p>
    <section class="container py-6">
      <h2 class="mb-4 text-2xl font-semibold">{dictionary.projectsIndex.recentHeading}</h2>
      {
        recentLocalized.length === 0 ? (
          <p class="text-slate-600 dark:text-slate-400">{dictionary.projectsIndex.recentEmpty}</p>
        ) : (
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {recentLocalized.map(({ entry, title, summary, links }) => (
              <li class="rounded border bg-white p-4 transition hover:shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                <a href={localizePath(`/projects/${entry.slug}`, locale)} class="block">
                  <h3 class="font-semibold">{title}</h3>
                  <p class="text-sm text-slate-700 dark:text-slate-300">{summary}</p>
                </a>
                {links.length ? (
                  <div class="mt-2 flex items-center gap-2">
                    {links.map((link) => (
                      <a
                        href={link.href}
                        rel="noopener noreferrer"
                        target="_blank"
                        aria-label={link.ariaLabel}
                        class="inline-flex"
                        title={link.label}
                      >
                        <img
                          src={link.icon.light}
                          alt={link.icon.alt}
                          width="16"
                          height="16"
                          loading="lazy"
                          class="h-4 w-4 rounded-sm"
                          data-theme-image
                          data-theme-src-light={link.icon.light}
                          data-theme-src-dark={link.icon.dark}
                          onerror={link.icon.onError}
                        />
                      </a>
                    ))}
                  </div>
                ) : null}
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <section class="container py-6">
      <h2 class="mb-4 text-2xl font-semibold">{dictionary.projectsIndex.allHeading}</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          localizedProjects.map(({ entry, title, summary, links }) => (
            <li class="rounded border bg-white p-4 transition hover:shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
              <a href={localizePath(`/projects/${entry.slug}`, locale)} class="block">
                <h3 class="font-semibold">{title}</h3>
                <p class="text-sm text-slate-700 dark:text-slate-300">{summary}</p>
                {entry.data.tags?.length ? (
                  <div class="mt-2 flex flex-wrap gap-2">
                    {entry.data.tags.map((t: string) => (
                      <a
                        href={localizePath(`/tags/${t}`, locale)}
                        class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-200"
                      >
                        {t}
                      </a>
                    ))}
                  </div>
                ) : null}
              </a>
              {links.length ? (
                <div class="mt-2 flex items-center gap-2">
                  {links.map((link) => (
                    <a
                      href={link.href}
                      rel="noopener noreferrer"
                      target="_blank"
                      aria-label={link.ariaLabel}
                      class="inline-flex"
                      title={link.label}
                    >
                      <img
                        src={link.icon.light}
                        alt={link.icon.alt}
                        width="16"
                        height="16"
                        loading="lazy"
                        class="h-4 w-4 rounded-sm"
                        data-theme-image
                        data-theme-src-light={link.icon.light}
                        data-theme-src-dark={link.icon.dark}
                        onerror={link.icon.onError}
                      />
                    </a>
                  ))}
                </div>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</Base>
