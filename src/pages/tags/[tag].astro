---
import Base from "~/layouts/Base.astro";
import { getCollection } from 'astro:content';
import { resolveProjectLink } from "~/lib/links";
import {
  getDictionary,
  resolveLocale,
  localizePath,
  resolveLocalizedValue,
} from "~/lib/i18n";

export async function getStaticPaths() {
  const tags = await getCollection('tags');
  return tags.map((t) => ({ params: { tag: t.data.id }, props: { tag: t.data.id, label: t.data.label } }));
}

const { tag, label } = Astro.props as { tag: string; label: string };
const projects = (await getCollection('projects')).filter((p) => (p.data.tags ?? []).includes(tag) && p.data.visibility !== 'private');

const locale = resolveLocale(Astro.currentLocale);
const dictionary = getDictionary(locale);
const pageTitle = `${dictionary.tagsIndex.detailMetaTitle(label)} – ${dictionary.site.name}`;
const pageDescription = dictionary.tagsIndex.detailMetaDescription(label);
const localizedProjects = projects.map((entry) => ({
  entry,
  title: resolveLocalizedValue(entry.data.title, locale) ?? '',
  summary: resolveLocalizedValue(entry.data.summary, locale) ?? '',
  links: (entry.data.links ?? []).map((link) => resolveProjectLink(link, dictionary)),
}));
---
<Base title={pageTitle} description={pageDescription}>
  <section class="container py-10">
    <h1 class="text-3xl font-bold mb-6">{dictionary.tagsIndex.detailTitle(label)}</h1>
    {localizedProjects.length === 0 ? (
      <p class="text-slate-700 dark:text-slate-300">{dictionary.tagsIndex.empty}</p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {localizedProjects.map(({ entry, title, summary, links }) => (
          <li class="p-4 border rounded bg-white transition hover:shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
            <a href={localizePath(`/projects/${entry.slug}`, locale)} class="block">
              <h3 class="font-semibold">{title}</h3>
              <p class="text-slate-700 text-sm dark:text-slate-300">{summary}</p>
            </a>
            {links.length ? (
              <div class="mt-2 flex items-center gap-2">
                {links.map((link) => (
                  <a
                    href={link.href}
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label={link.ariaLabel}
                    class="inline-flex"
                    title={link.label}
                  >
                    <img
                      src={link.icon.light}
                      alt={link.icon.alt}
                      width="16"
                      height="16"
                      loading="lazy"
                      class="w-4 h-4 rounded-sm"
                      data-theme-image
                      data-theme-src-light={link.icon.light}
                      data-theme-src-dark={link.icon.dark}
                      onerror={link.icon.onError}
                    />
                  </a>
                ))}
              </div>
            ) : null}
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
