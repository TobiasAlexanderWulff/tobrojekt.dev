---
type Props = {
  tags?: string[];
  max?: number;
  className?: string;
};

const props = Astro.props as Props;
const tags = Array.isArray(props.tags) ? props.tags.filter((tag) => tag && tag.trim().length > 0) : [];
const max = typeof props.max === 'number' ? props.max : 6;
const visibleTags = tags.slice(0, max);
const remainingCount = tags.length - visibleTags.length;
---

{
  visibleTags.length > 0 ? (
    <div class={`flex flex-wrap gap-2 ${props.className ?? ''}`}>
      {visibleTags.map((tag) => (
        <span class="rounded-full border border-slate-200/70 bg-slate-100/70 px-2.5 py-1 text-[11px] font-medium tracking-wide text-slate-600 dark:border-slate-700/80 dark:bg-slate-800/55 dark:text-slate-300">
          {tag}
        </span>
      ))}
      {remainingCount > 0 ? (
        <span class="rounded-full border border-slate-300/80 bg-slate-200/70 px-2.5 py-1 text-[11px] font-medium text-slate-600 dark:border-slate-600/80 dark:bg-slate-700/70 dark:text-slate-200">
          +{remainingCount}
        </span>
      ) : null}
    </div>
  ) : null
}
